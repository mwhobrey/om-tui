{
  "manifest_version": 3,
  "name": "om-tui Google Cookies",
	"version": "1.0.4",
  "description": "Keeps a native-messaging bridge open so om-tui can refresh Google Messages session cookies without DevTools paste.",
  "key": "",
  "permissions": ["alarms", "cookies", "nativeMessaging", "storage"],
  "host_permissions": [
    "https://google.com/",
    "https://*.google.com/",
    "http://google.com/",
    "http://*.google.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "om-tui: push Google cookies now",
    "default_popup": "popup.html"
  }
}
